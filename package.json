{
  "name": "clean-forum-nest-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && rm -rf dist/shared/types",
    "check-types": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch --exec 'node --env-file=.env.development'",
    "start:debug": "nest start --debug --watch --exec 'node --env-file=.env.development'",
    "start:prod": "node --env-file=.env.production dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run .test.",
    "test:unit:watch": "vitest .test.",
    "test:e2e": "dotenv -e .env.test --quiet -- vitest run --config vitest.config.e2e.mts",
    "test:e2e:watch": "dotenv -e .env.test --quiet -- vitest --config vitest.config.e2e.mts",
    "test:staged": "vitest related --run",
    "test:ci": "vitest --run --silent --coverage",
    "test:dir": "vitest --run --silent --reporter verbose --dir",
    "test:mutation": "stryker run",
    "migrate": "dotenv -e .env -- prisma migrate dev",
    "migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "migrate:test": "dotenv -e .env.test -- prisma migrate dev",
    "migrate:reset": "dotenv -e .env -- prisma migrate reset",
    "migrate:reset:dev": "dotenv -e .env.development -- prisma migrate reset",
    "migrate:reset:test": "dotenv -e .env.test -- prisma migrate reset",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "db:up:dev": "dotenv -e .env.development -- docker-compose -p forum_dev -f docker-compose.development.yml up --build -d",
    "db:up:test": "dotenv -e .env.test -- docker-compose -p forum_test -f docker-compose.test.yml up --build -d",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@bull-board/api": "^6.15.0",
    "@bull-board/express": "^6.15.0",
    "@bull-board/nestjs": "^6.15.0",
    "@fastify/compress": "^8.3.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-pg": "^7.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "nestjs-zod": "^5.0.1",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.1.0",
    "zod": "^4.1.13",
    "zod-error-map": "0.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@prisma/client": "7.1.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@swc/core": "^1.15.3",
    "@types/bcrypt": "^6.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@vitest/eslint-plugin": "^1.5.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslightning": "^0.3.8",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "fastify": "^5.6.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "neostandard": "^0.12.2",
    "prisma": "7.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.15",
    "vitest-tsconfig-paths": "^3.4.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
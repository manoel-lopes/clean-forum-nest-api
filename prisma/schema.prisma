// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ========================================
// Models
// ========================================

model User {
  id        String   @id @default(uuid(7))
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  questions     Question[]
  answers       Answer[]
  comments      Comment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Question {
  id           String   @id @default(uuid(7))
  title        String
  slug         String   @unique
  content      String
  authorId     String
  bestAnswerId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  author      User         @relation(fields: [authorId], references: [id])
  answers     Answer[]
  comments    Comment[]
  attachments Attachment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([slug])
  @@map("questions")
}

model Answer {
  id         String   @id @default(uuid(7))
  content    String
  authorId   String
  questionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  excerpt    String

  author      User         @relation(fields: [authorId], references: [id])
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  comments    Comment[]
  attachments Attachment[]

  @@index([questionId])
  @@index([authorId])
  @@index([createdAt])
  @@index([questionId, createdAt])
  @@map("answers")
}

model Comment {
  id         String    @id @default(uuid(7))
  content    String
  authorId   String
  questionId String?
  answerId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([answerId])
  @@index([authorId])
  @@index([createdAt])
  @@index([questionId, createdAt])
  @@index([answerId, createdAt])
  @@map("comments")
}

model Attachment {
  id         String    @id @default(uuid(7))
  title      String
  url        String
  questionId String?
  answerId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer   Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([answerId])
  @@index([createdAt])
  @@index([questionId, createdAt])
  @@index([answerId, createdAt])
  @@map("attachments")
}

model RefreshToken {
  id        String   @id @default(uuid(7))
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailValidation {
  id         String   @id @default(uuid(7))
  email      String   @unique
  code       String
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("email_validations")
}
